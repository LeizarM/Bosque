	<parameter name="subRptDetComisionEpp" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<!-- El detalle por item, que lee tcom_pagadoItem via p_list_tcom_PagadoItem.
	     Los cuatro parametros de abajo son de ese subreporte y no de este: viajan
	     por aca porque un subreporte solo recibe lo que el padre le pasa.
	       esInterno    como se congelo el periodo (internas y Epp son 1).
	       origen       la empresa. Aca SI viaja con valor -ESPPAPEL-, que es un
	                    origen unico y por lo tanto se puede pedir con el @origen
	                    del SP: el corte lo hace la base y el reporte ya no tiene
	                    que descartar filas de la otra empresa.
	       esEpp        que empresa imprime este reporte: rotula la portada y el
	                    texto de la banda sin datos.
	       lecturaItems por que el periodo puede no tener items DE ESTA EMPRESA.
	                    Sin esto, un periodo sin detalle imprimiria una hoja en
	                    blanco, que es indistinguible de un historico que no se
	                    escribio. -->
	<parameter name="subRptItemComision" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="esInterno" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[Integer.valueOf(1)]]></defaultValueExpression>
	</parameter>
	<!-- Con default, para que abierto suelto en Jaspersoft Studio muestre lo de
	     Esppapel y no las dos empresas juntas. -->
	<parameter name="origen" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["ESPPAPEL"]]></defaultValueExpression>
	</parameter>
	<parameter name="esEpp" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[Boolean.TRUE]]></defaultValueExpression>
	</parameter>
	<parameter name="lecturaItems" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[execute p_list_pagado @mes=$P{mes}, @anio=$P{anio}, @ACCION='F']]>
	</queryString>
