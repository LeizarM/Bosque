	<style name="chipComision" mode="Opaque" backcolor="#CC79A7" forecolor="#000000">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} == null]]></conditionExpression>
			<style mode="Transparent"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.0) < 0.0000005]]></conditionExpression>
			<style backcolor="#BDBDBD" forecolor="#000000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.002) < 0.0000005]]></conditionExpression>
			<style backcolor="#FDE725" forecolor="#000000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.003) < 0.0000005]]></conditionExpression>
			<style backcolor="#B5DE2B" forecolor="#000000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.004) < 0.0000005]]></conditionExpression>
			<style backcolor="#6ECE58" forecolor="#000000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.005) < 0.0000005]]></conditionExpression>
			<style backcolor="#35B779" forecolor="#000000"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.006) < 0.0000005]]></conditionExpression>
			<style backcolor="#1F9E89" forecolor="#FFFFFF"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.007) < 0.0000005]]></conditionExpression>
			<style backcolor="#26828E" forecolor="#FFFFFF"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.008) < 0.0000005]]></conditionExpression>
			<style backcolor="#31688E" forecolor="#FFFFFF"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{comision} != null && Math.abs($F{comision}.doubleValue() - 0.01) < 0.0000005]]></conditionExpression>
			<style backcolor="#3E4A89" forecolor="#FFFFFF"/>
		</conditionalStyle>
	</style>
