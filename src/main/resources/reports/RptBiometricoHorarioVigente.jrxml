<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RptBiometricoHorarioVigente" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="net.sf.jasperreports.default.text.field.blank.when.null" value="true"/>
	<!-- Mismo criterio que RptBiometricoResumenMensual: puede haber ~400 filas,
	     la franja alternada evita perder la fila al leer de izquierda a derecha
	     por los 7 días. -->
	<style name="filaZebra" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></conditionExpression>
			<style mode="Opaque" backcolor="#F5F7FA"/>
		</conditionalStyle>
	</style>
	<parameter name="fechaGeneracion" class="java.util.Date"/>
	<field name="nombreEmpleado" class="java.lang.String"/>
	<field name="nombreHorarioSemanal" class="java.lang.String"/>
	<field name="vigenteDesde" class="java.util.Date"/>
	<field name="lunes" class="java.lang.String"/>
	<field name="martes" class="java.lang.String"/>
	<field name="miercoles" class="java.lang.String"/>
	<field name="jueves" class="java.lang.String"/>
	<field name="viernes" class="java.lang.String"/>
	<field name="sabado" class="java.lang.String"/>
	<field name="domingo" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="46" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="752" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Horario Vigente por Empleado]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy HH:mm">
				<reportElement x="0" y="26" width="752" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Generado: " + $P{fechaGeneracion}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="44" width="752" height="1"/>
				<graphicElement>
					<pen lineWidth="1.0" lineColor="#37474F"/>
				</graphicElement>
			</line>
		</band>
	</title>
	<columnHeader>
		<band height="28" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="145" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Empleado]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="145" y="0" width="90" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Horario Semanal]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="235" y="0" width="55" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[Vigente Desde]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="290" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Lunes]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="356" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Martes]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="422" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Miércoles]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="488" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Jueves]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="554" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Viernes]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="620" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Sábado]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="686" y="0" width="66" height="28" backcolor="#37474F" forecolor="#FFFFFF"/>
				<box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Domingo]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField>
				<reportElement style="filaZebra" x="0" y="0" width="145" height="15"/>
				<box leftPadding="3"><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nombreEmpleado}]]></textFieldExpression>
