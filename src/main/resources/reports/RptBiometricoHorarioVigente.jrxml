			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="290" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{lunes}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="356" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{martes}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="422" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{miercoles}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="488" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{jueves}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="554" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{viernes}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="620" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{sabado}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="filaZebra" x="686" y="0" width="66" height="15"/>
				<box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{domingo}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="16" splitType="Stretch">
			<textField>
				<reportElement x="652" y="0" width="100" height="14"/>
				<textElement textAlignment="Right">
