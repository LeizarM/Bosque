	<parameter name="subRptDetComision" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<!-- El detalle por item, que lee tcom_pagadoItem via p_list_tcom_PagadoItem.
	     Los cuatro parametros de abajo son de ese subreporte y no de este: viajan
	     por aca porque un subreporte solo recibe lo que el padre le pasa.
	       esInterno    como se congelo el periodo (internas y Epp son 1).
	       origen       la empresa, para que el corte lo haga el SP. En ESTE
	                    reporte viaja en NULL a proposito: las internas son tres
	                    origenes -IMPEXPAP, PAPIRUS, PRODUCTIVA PAPEL- y @origen
	                    compara por igualdad, asi que no hay forma de pedir "todas
	                    menos ESPPAPEL" en un llamado. La negacion la sigue
	                    haciendo el filterExpression del subreporte.
	       esEpp        que empresa imprime este reporte: rotula, y con origen en
	                    null es ademas lo que separa las dos empresas.
	       lecturaItems por que el periodo puede no tener items. Sin esto, un
	                    periodo sin detalle imprimiria una hoja en blanco, que
	                    es indistinguible de un historico que no se escribio. -->
	<parameter name="subRptItemComision" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
	<parameter name="esInterno" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[Integer.valueOf(1)]]></defaultValueExpression>
	</parameter>
	<!-- Sin defaultValueExpression: null es un valor con significado -sin filtro-
	     y un default lo pisaria. -->
	<parameter name="origen" class="java.lang.String" isForPrompting="false"/>
	<parameter name="esEpp" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression>
	</parameter>
	<parameter name="lecturaItems" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[execute p_list_pagado @mes=$P{mes}, @anio=$P{anio}, @ACCION='B']]>
	</queryString>
