<?xml version="1.0" encoding="UTF-8"?>
<!-- Ficha de un talonario: su historia completa, un evento por fila.

     No tiene equivalente en el legacy. Los cuatro reportes viejos eran todos
     listados de muchos talonarios; ninguno contestaba "que paso con ESTE".
     Cuando faltaba un talonario habia que ir a mirar la grilla de detalle en
     pantalla y anotarlo a mano.

     Vertical y no apaisado: es una hoja por talonario, pensada para imprimir y
     adjuntar a un descargo o a un acta. Vertical entra en un folder.

     El orden lo pone el SP por codDetalle y no por fechaEvento —fechaEvento la
     informa el usuario y en produccion hay casos anteriores al alta—, asi que
     la columna "#" del movimiento es el orden real de los hechos. La fecha de
     carga va al lado justamente para que se vea cuando difieren.

     La cabecera del talonario viene repetida en cada fila desde el SP y se
     imprime una sola vez, en el groupHeader. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RptTalFicha" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1c7e2a4-1f10-4c8e-9a11-3d5f7c210004" whenNoDataType="AllSectionsNoDetail">
	<property name="ireport.zoom" value="1.0"/>
	<style name="talCabecera" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF"/>
	<style name="talRegla" mode="Opaque" backcolor="#1F3A5F"/>
	<style name="talFicha" mode="Opaque" backcolor="#DCE6F1" forecolor="#1F3A5F"/>
	<style name="talCebra" mode="Opaque">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F2F5F9"/>
		</conditionalStyle>
	</style>

	<parameter name="codTalonario" class="java.lang.Long" isForPrompting="false"/>

	<queryString>
		<![CDATA[EXEC dbo.p_rpt_tmto_Talonario @ACCION = 'F', @codTalonario = $P{codTalonario}]]>
	</queryString>

	<field name="codTalonario" class="java.lang.Long"/>
	<field name="nroTalonario" class="java.lang.String"/>
	<field name="rangoFolios" class="java.lang.String"/>
	<field name="cantidadFolios" class="java.lang.Integer"/>
	<field name="costoBs" class="java.math.BigDecimal"/>
	<field name="observacionTalonario" class="java.lang.String"/>
	<field name="datoEmpresa" class="java.lang.String"/>
	<field name="datoTipo" class="java.lang.String"/>
	<field name="codDetalle" class="java.lang.Long"/>
	<field name="codEstado" class="java.lang.Integer"/>
	<field name="datoEstado" class="java.lang.String"/>
	<field name="fechaEvento" class="java.sql.Date"/>
	<field name="fechaCarga" class="java.sql.Timestamp"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="datoDestinatario" class="java.lang.String"/>
	<field name="nroMovimiento" class="java.lang.Long"/>

	<variable name="salidas" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{codEstado} != null && $F{codEstado}.intValue() == 2 ? Integer.valueOf(1) : Integer.valueOf(0)]]></variableExpression>
	</variable>
	<variable name="retornos" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{codEstado} != null && ($F{codEstado}.intValue() == 3 || $F{codEstado}.intValue() == 4) ? Integer.valueOf(1) : Integer.valueOf(0)]]></variableExpression>
	</variable>
	<variable name="cerrado" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{codEstado} != null && $F{codEstado}.intValue() == 4 ? Integer.valueOf(1) : Integer.valueOf(0)]]></variableExpression>
	</variable>

	<!-- Un solo grupo, que se dispara una vez: es la cabecera de la ficha. Va
	     como grupo y no como <title> porque los datos vienen de los $F, no de
	     parametros: el reporte se invoca solo con el codTalonario. -->
	<group name="gTalonario">
		<groupExpression><![CDATA[$F{codTalonario}]]></groupExpression>
		<groupHeader>
			<band height="96">
				<textField>
					<reportElement style="talFicha" x="0" y="0" width="555" height="24" uuid="b1c7e2a4-0002-0003-0000-000000000001"/>
					<textElement verticalAlignment="Middle"><font size="14" isBold="true"/><paragraph leftIndent="8"/></textElement>
					<textFieldExpression><![CDATA["Talonario " + $F{nroTalonario}]]></textFieldExpression>
				</textField>

				<staticText>
					<reportElement x="0" y="30" width="70" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000002"/>
					<textElement><font size="8" isBold="true"/></textElement>
					<text><![CDATA[Empresa]]></text>
				</staticText>
				<textField textAdjust="StretchHeight">
					<reportElement x="70" y="30" width="200" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000003"/>
					<textElement><font size="8"/></textElement>
					<textFieldExpression><![CDATA[$F{datoEmpresa}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="285" y="30" width="70" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000004"/>
					<textElement><font size="8" isBold="true"/></textElement>
					<text><![CDATA[Tipo]]></text>
				</staticText>
				<textField textAdjust="StretchHeight">
					<reportElement x="355" y="30" width="200" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000005"/>
					<textElement><font size="8"/></textElement>
					<textFieldExpression><![CDATA[$F{datoTipo}]]></textFieldExpression>
				</textField>

				<staticText>
					<reportElement x="0" y="45" width="70" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000006"/>
					<textElement><font size="8" isBold="true"/></textElement>
					<text><![CDATA[Folios]]></text>
				</staticText>
				<textField>
					<reportElement x="70" y="45" width="200" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000007"/>
					<textElement><font size="8"/></textElement>
					<textFieldExpression><![CDATA[$F{rangoFolios} + "   (" + $F{cantidadFolios} + " folios)"]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="285" y="45" width="70" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000008"/>
					<textElement><font size="8" isBold="true"/></textElement>
					<text><![CDATA[Costo]]></text>
				</staticText>
				<textField pattern="#,##0.00">
					<reportElement x="355" y="45" width="200" height="13" uuid="b1c7e2a4-0002-0003-0000-000000000009"/>
					<textElement><font size="8"/></textElement>
					<textFieldExpression><![CDATA[$F{costoBs}]]></textFieldExpression>
				</textField>

				<staticText>
					<reportElement x="0" y="60" width="70" height="13" uuid="b1c7e2a4-0002-0003-0000-00000000000a"/>
					<textElement><font size="8" isBold="true"/></textElement>
					<text><![CDATA[Observacion]]></text>
				</staticText>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="70" y="60" width="485" height="13" uuid="b1c7e2a4-0002-0003-0000-00000000000b"/>
					<textElement><font size="8"/></textElement>
					<textFieldExpression><![CDATA[$F{observacionTalonario}]]></textFieldExpression>
				</textField>

				<staticText>
					<reportElement x="0" y="80" width="300" height="13" uuid="b1c7e2a4-0002-0003-0000-00000000000c"/>
					<textElement><font size="10" isBold="true"/></textElement>
					<text><![CDATA[Historial de movimientos]]></text>
				</staticText>
			</band>
		</groupHeader>
	</group>

	<title>
		<band height="34">
			<textField>
				<reportElement x="0" y="0" width="400" height="18" uuid="b1c7e2a4-0001-0003-0000-000000000001"/>
				<textElement><font size="13" isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Ficha de talonario"]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy HH:mm">
				<reportElement x="375" y="2" width="180" height="14" uuid="b1c7e2a4-0001-0003-0000-000000000002"/>
				<textElement textAlignment="Right"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<line>
				<reportElement style="talRegla" x="0" y="26" width="555" height="3" uuid="b1c7e2a4-0001-0003-0000-000000000003"/>
			</line>
		</band>
	</title>

	<columnHeader>
		<band height="18">
			<staticText>
				<reportElement style="talCabecera" x="0" y="0" width="26" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000001"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[#]]></text>
			</staticText>
			<staticText>
				<reportElement style="talCabecera" x="26" y="0" width="70" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000002"/>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
				<text><![CDATA[FECHA]]></text>
			</staticText>
			<staticText>
				<reportElement style="talCabecera" x="96" y="0" width="90" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000003"/>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
				<text><![CDATA[MOVIMIENTO]]></text>
			</staticText>
			<staticText>
				<reportElement style="talCabecera" x="186" y="0" width="155" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000004"/>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
				<text><![CDATA[ENTREGADO A]]></text>
			</staticText>
			<staticText>
				<reportElement style="talCabecera" x="341" y="0" width="144" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000005"/>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
				<text><![CDATA[OBSERVACION]]></text>
			</staticText>
			<staticText>
				<reportElement style="talCabecera" x="485" y="0" width="70" height="16" uuid="b1c7e2a4-0004-0003-0000-000000000006"/>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
				<text><![CDATA[CARGADO]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="15">
			<frame>
				<reportElement style="talCebra" x="0" y="0" width="555" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000000"/>
				<textField>
					<reportElement x="0" y="0" width="26" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000001"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
					<textFieldExpression><![CDATA[$F{nroMovimiento}]]></textFieldExpression>
				</textField>
				<textField pattern="dd/MM/yyyy">
					<reportElement x="26" y="0" width="70" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000002"/>
					<textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="4"/></textElement>
					<textFieldExpression><![CDATA[$F{fechaEvento}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="96" y="0" width="90" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000003"/>
					<textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="4"/></textElement>
					<textFieldExpression><![CDATA[$F{datoEstado}]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="186" y="0" width="155" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000004"/>
					<textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="4"/></textElement>
					<textFieldExpression><![CDATA[$F{datoDestinatario}]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement x="341" y="0" width="144" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000005"/>
					<textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
					<textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression>
				</textField>
				<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
					<reportElement x="485" y="0" width="70" height="14" uuid="b1c7e2a4-0005-0003-0000-000000000006"/>
					<textElement verticalAlignment="Middle"><font size="7"/><paragraph leftIndent="4"/></textElement>
					<textFieldExpression><![CDATA[$F{fechaCarga}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</detail>

	<pageFooter>
		<band height="16">
			<textField>
				<reportElement x="0" y="2" width="300" height="12" uuid="b1c7e2a4-0006-0003-0000-000000000001"/>
				<textElement><font size="7" isItalic="true"/></textElement>
				<textFieldExpression><![CDATA["RptTalFicha"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="355" y="2" width="160" height="12" uuid="b1c7e2a4-0006-0003-0000-000000000002"/>
				<textElement textAlignment="Right"><font size="7"/></textElement>
				<textFieldExpression><![CDATA["Pagina " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="517" y="2" width="38" height="12" uuid="b1c7e2a4-0006-0003-0000-000000000003"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="72">
			<line>
				<reportElement style="talRegla" x="0" y="2" width="555" height="2" uuid="b1c7e2a4-0007-0003-0000-000000000001"/>
			</line>
			<textField>
				<reportElement style="talFicha" x="0" y="6" width="555" height="18" uuid="b1c7e2a4-0007-0003-0000-000000000002"/>
				<textElement verticalAlignment="Middle"><font size="9" isBold="true"/><paragraph leftIndent="6"/></textElement>
				<textFieldExpression><![CDATA[$V{REPORT_COUNT} + " movimientos   ·   " + $V{salidas} + " salidas   ·   " + $V{retornos} + " retornos   ·   " + ($V{cerrado} != null && $V{cerrado}.intValue() > 0 ? "CERRADO" : "vigente")]]></textFieldExpression>
			</textField>

			<!-- Espacio de firma. La ficha se imprime para adjuntar a un
			     descargo, y el descargo necesita quien lo recibio. -->
			<line>
				<reportElement x="40" y="52" width="180" height="1" forecolor="#666666" uuid="b1c7e2a4-0007-0003-0000-000000000003"/>
			</line>
			<staticText>
				<reportElement x="40" y="54" width="180" height="12" uuid="b1c7e2a4-0007-0003-0000-000000000004"/>
				<textElement textAlignment="Center"><font size="7"/></textElement>
				<text><![CDATA[Entrega]]></text>
			</staticText>
			<line>
				<reportElement x="335" y="52" width="180" height="1" forecolor="#666666" uuid="b1c7e2a4-0007-0003-0000-000000000005"/>
			</line>
			<staticText>
				<reportElement x="335" y="54" width="180" height="12" uuid="b1c7e2a4-0007-0003-0000-000000000006"/>
				<textElement textAlignment="Center"><font size="7"/></textElement>
				<text><![CDATA[Recibe]]></text>
			</staticText>
		</band>
	</summary>
</jasperReport>
